    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mm2vault.nexkey"
    },
    "android": {
      "package": "com.mm2vault.nexkey",
      "softwareKeyboardLayoutMode": "pan"
    },
    "plugins": [
      "./plugins/withNexKeyKeyboard"
    ]
  }
}
